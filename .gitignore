# build outputs (recreated by `python build.py`)
bin/
build/
*.exe
*.o

# CUDA headers + NVRTC (downloaded by `python build.py --fetch-cuda`; DLLs exceed GitHub's file limit)
third_party/

# raw animation snapshots (recreated by `python scripts/animate.py`)
results/animation/*.snap

# Python / editors / OS
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store
Thumbs.db

# personal notes and local tooling
PROJECT_EXPLAINED.txt
.claude/

# presentation build artefacts
presentation/node_modules/
presentation/render/
presentation/guide_render/
presentation/zoom.png
presentation/preview_stars.png
presentation/fonttest.*
presentation/embedded_tmp.pptx
